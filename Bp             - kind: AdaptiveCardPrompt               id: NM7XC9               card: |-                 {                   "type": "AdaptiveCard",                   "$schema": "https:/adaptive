            - kind: AdaptiveCardPrompt
              id: NM7XC9
              card: |-
                {
                  "type": "AdaptiveCard",
                  "$schema": "https://adaptivecards.io/schemas/adaptive-card.json",
                  "version": "1.5",
                  "body": [
                    {
                      "type": "TextBlock",
                      "text": "Before you submit",
                      "weight": "Bolder",
                      "size": "Medium",
                      "wrap": true
                    },
                    {
                      "type": "Input.ChoiceSet",
                      "id": "hrbp",
                      "label": "Which HR Business Partner should review this request?",
                      "style": "expanded",
                      "isRequired": true,
                      "errorMessage": "Please choose an HR Business Partner.",
                      "choices": [
                        {
                          "title": "HRBP_NAME_1",
                          "value": "hrbp1@example.com"
                        },
                        {
                          "title": "HRBP_NAME_2",
                          "value": "hrbp2@example.com"
                        }
                      ]
                    },
                    {
                      "type": "TextBlock",
                      "text": "By submitting, I confirm that:",
                      "spacing": "Medium",
                      "wrap": true
                    },
                    {
                      "type": "TextBlock",
                      "text": "- These changes reflect the current, ongoing duties and requirements of this position.\n- They describe the job, not the performance or qualifications of a specific employee.\n- The information and business reason I provided are accurate and complete to the best of my knowledge.",
                      "wrap": true,
                      "spacing": "Small"
                    },
                    {
                      "type": "TextBlock",
                      "text": "- I understand these updates are not final or official until they have been reviewed and approved by HR.",
                      "weight": "Bolder",
                      "wrap": true,
                      "spacing": "None"
                    },
                    {
                      "type": "TextBlock",
                      "text": "- I understand I will receive updates throughout the HR review process, including any questions, requested changes, notes, or approval decisions.",
                      "wrap": true,
                      "spacing": "None"
                    },
                    {
                      "type": "Input.Toggle",
                      "id": "attestCheck",
                      "title": "I confirm the statements above",
                      "valueOn": "yes",
                      "valueOff": "no",
                      "value": "no",
                      "isRequired": true,
                      "errorMessage": "Please confirm to submit.",
                      "label": "Attestation Confirmation"
                    }
                  ],
                  "actions": [
                    {
                      "type": "Action.Submit",
                      "title": "Submit to HR",
                      "style": "positive",
                      "data": {
                        "attestChoice": "submit"
                      }
                    },
                    {
                      "type": "Action.Submit",
                      "title": "Go back",
                      "associatedInputs": "none",
                      "data": {
                        "attestChoice": "back"
                      }
                    }
                  ]
                }
              output:
                binding:
                  actionSubmitId: Topic.actionSubmitId
                  attestCheck: Topic.attestCheck
                  attestChoice: Topic.attestChoice
                  hrbp: Topic.SelectedHRBP

              outputType:
                properties:
                  actionSubmitId: String
                  attestCheck: String
                  attestChoice: String
                  hrbp: String

            - kind: ConditionGroup
              id: conditionGroup_cvsKZa
              conditions:
                - id: conditionItem_p8Si42
                  condition: =Topic.attestChoice = "back"
                  actions:
                    - kind: SetVariable
                      id: setVariable_L742vN
                      variable: Topic.Ask
                      value: No problem, nothing has been sent. When you're ready, choose an option below.

                    - kind: GotoAction
                      id: KE9Lm1
                      actionId: question_7s2x42

                - id: conditionItem_sbNoHRBP
                  condition: =IsBlank(Topic.SelectedHRBP)
                  actions:
                    - kind: SendActivity
                      id: sendActivity_sbNoHRBP
                      activity: Please choose an **HR Business Partner** on the card to submit, or choose _Go back_.

                    - kind: GotoAction
                      id: gotoAction_sbNoHRBP
                      actionId: NM7XC9

                - id: conditionItem_cFaMpg
                  condition: =Topic.attestCheck <> "yes"
                  actions:
                    - kind: SendActivity
                      id: sendActivity_KD2uFA
                      activity: Please check **I confirm the statements above** to submit, or choose _Go Back_.

                    - kind: GotoAction
                      id: liYENh
                      actionId: NM7XC9

